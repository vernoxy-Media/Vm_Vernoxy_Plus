{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "typeRoots": [
      "./node_modules/@types",
      "./apps/api/node_modules/@types"
    ],
    "types": ["node", "jest", "multer"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "apps/api/src/**/*",
    "apps/api/test/**/*",
    "database/**/*",
    "scripts/**/*"
  ]
}
