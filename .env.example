# ==============================================================================
# Vernoxy Pulse Environment Configuration Template
# ==============================================================================

# Application Port & Environment
PORT=3000
NODE_ENV=development

# Database Connections (Neon Serverless PostgreSQL)
# DATABASE_URL: Neon POOLED connection string (host contains "-pooler").
# Used by runtime NestJS API and Prisma Client.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Neon DIRECT (non-pooled) connection string.
# Used by dbmate migrations and Prisma CLI (introspection / db pull).
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# dbmate migrations ledger table in dedicated schema
DBMATE_MIGRATIONS_TABLE="dbmate.schema_migrations"

# First Admin Bootstrap Configuration (Optional env overrides for pnpm bootstrap:admin)
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_MOBILE=
# Interactive prompt used if BOOTSTRAP_ADMIN_PASSWORD is omitted (CI only)
BOOTSTRAP_ADMIN_PASSWORD=

# Authentication & JWT Configuration (RS256 PEM Base64 encoded)
JWT_PRIVATE_KEY="<base64-encoded-pkcs8-rsa-private-key-pem>"
JWT_PUBLIC_KEY="<base64-encoded-spki-rsa-public-key-pem>"
JWT_KEY_ID="kid_sample123456"
JWT_ISSUER="pulse-api"
JWT_AUDIENCE="pulse-web"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
OTP_HMAC_SECRET="<minimum-32-characters-hex-secret>"

# Mail Configuration (SMTP / Mailpit)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@vernoxy.com"

# Web Client & Cookies
WEB_ORIGIN="http://localhost:5173"
COOKIE_SECURE=false

# File Storage Configuration
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
FILE_URL_SECRET="<minimum-32-characters-secret>"
FILE_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=5242880


