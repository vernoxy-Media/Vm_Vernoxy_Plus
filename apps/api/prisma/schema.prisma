  company_persons                                  company_persons[]
  crm_communications                               crm_communications[]
  crm_follow_ups                                   crm_follow_ups[]
  crm_lead_notes                                   crm_lead_notes[]
  kb_feedback                                      kb_feedback[]
  leads                                            leads[]
