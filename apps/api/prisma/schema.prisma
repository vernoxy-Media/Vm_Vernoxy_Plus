generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model companies {
  company_id                                       Int                @id(map: "pk_companies") @default(autoincrement())
  name                                             String             @db.VarChar(255)
  parent_company_id                                Int?
  customer_type_id                                 Int
  industry_id                                      Int
  sub_industry_id                                  Int?
  address                                          String?
  city                                             String?            @db.VarChar(100)
  state                                            String?            @db.VarChar(100)
  country                                          String?            @db.VarChar(100)
  owner_id                                         Int?
  is_active                                        Boolean            @default(true)
  created_at                                       DateTime           @default(now()) @db.Timestamptz(6)
  created_by                                       Int?
  updated_at                                       DateTime?          @db.Timestamptz(6)
  updated_by                                       Int?
  deleted_at                                       DateTime?          @db.Timestamptz(6)
  deleted_by                                       Int?
  employees_companies_created_byToemployees        employees?         @relation("companies_created_byToemployees", fields: [created_by], references: [emp_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_created_by")
  customer_types                                   customer_types     @relation(fields: [customer_type_id], references: [customer_type_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_customer_type_id")
  employees_companies_deleted_byToemployees        employees?         @relation("companies_deleted_byToemployees", fields: [deleted_by], references: [emp_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_deleted_by")
  industries_companies_industry_idToindustries     industries         @relation("companies_industry_idToindustries", fields: [industry_id], references: [industry_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_industry_id")
  employees_companies_owner_idToemployees          employees?         @relation("companies_owner_idToemployees", fields: [owner_id], references: [emp_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_owner_id")
  companies                                        companies?         @relation("companiesTocompanies", fields: [parent_company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_parent_company_id")
  other_companies                                  companies[]        @relation("companiesTocompanies")
  industries_companies_sub_industry_idToindustries industries?        @relation("companies_sub_industry_idToindustries", fields: [sub_industry_id], references: [industry_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_sub_industry_id")
  employees_companies_updated_byToemployees        employees?         @relation("companies_updated_byToemployees", fields: [updated_by], references: [emp_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_updated_by")
