  roles                                                roles          @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([candidate_code], map: "ix_candidates_code")
  @@index([created_at(sort: Desc)], map: "ix_candidates_created_at")
  @@index([dep_id], map: "ix_candidates_dep_id")
  @@index([email], map: "ix_candidates_email")
  @@index([phone], map: "ix_candidates_phone")
  @@index([role_id], map: "ix_candidates_role_id")
  @@index([source], map: "ix_candidates_source")
  @@index([stage], map: "ix_candidates_stage")
  @@index([decision_date], map: "ix_candidates_decision_date")
  @@index([final_dep_id], map: "ix_candidates_final_dep")
  @@index([final_role_id], map: "ix_candidates_final_role")
}

