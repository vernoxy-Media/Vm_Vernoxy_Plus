  default_approver_id                                    Int?
  default_review_cycle_months                            Int?
  default_ack_required                                   Boolean       @default(false)
  default_audience_scope                                 String        @default("ALL") @db.VarChar(20)
  default_audience_departments                           Int[]         @default([])
  default_audience_roles                                 Int[]         @default([])
  default_audience_employees                             Int[]         @default([])
  default_audience_companies                             Int[]         @default([])
  default_audience_projects                              Int[]         @default([])
  display_order                                          Int           @default(0)
  is_active                                              Boolean       @default(true)
  created_at                                             DateTime      @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by                                             Int?
  updated_at                                             DateTime?     @db.Timestamptz(6)
  updated_by                                             Int?
  kb_articles                                            kb_articles[]
  employees_kb_categories_created_byToemployees          employees?    @relation("kb_categories_created_byToemployees", fields: [created_by], references: [emp_id], onUpdate: NoAction)
  employees_kb_categories_default_approver_idToemployees employees?    @relation("kb_categories_default_approver_idToemployees", fields: [default_approver_id], references: [emp_id], onUpdate: NoAction)
  employees_kb_categories_default_owner_idToemployees    employees?    @relation("kb_categories_default_owner_idToemployees", fields: [default_owner_id], references: [emp_id], onUpdate: NoAction)
  employees_kb_categories_updated_byToemployees          employees?    @relation("kb_categories_updated_byToemployees", fields: [updated_by], references: [emp_id], onUpdate: NoAction)
}

model kb_feedback {
  feedback_id         Int                 @id @default(autoincrement())
  article_id          Int
  version_id          Int
  is_helpful          Boolean
  comment             String?
  emp_id              Int?
  company_id          Int?
  project_id          Int?
  created_at          DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  kb_articles         kb_articles         @relation(fields: [article_id], references: [article_id], onDelete: Cascade, onUpdate: NoAction)
  companies           companies?          @relation(fields: [company_id], references: [company_id], onUpdate: NoAction)
  employees           employees?          @relation(fields: [emp_id], references: [emp_id], onUpdate: NoAction)
  projects            projects?           @relation(fields: [project_id], references: [project_id], onUpdate: NoAction)
  kb_article_versions kb_article_versions @relation(fields: [version_id], references: [version_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([article_id, version_id], map: "ix_kb_feedback_article")
}

